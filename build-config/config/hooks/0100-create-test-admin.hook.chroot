#!/bin/sh
set -e

# Имя тестового администратора
TEST_USER="testadmin"

# Создаем пользователя с домашней папкой и стандартным shell
# Флаг -G sudo добавляет пользователя в группу администраторов
useradd -m -s /bin/bash -G sudo $TEST_USER

# Задаем пароль (неинтерактивно)
# Пароль: KamingAdmin2024!
echo "$TEST_USER:KamingAdmin2024!" | chpasswd

# На всякий случай разблокируем аккаунт (если политики безопасности Debian заблокировали его)
passwd -u $TEST_USER || true

echo "Тестовый администратор $TEST_USER успешно создан."
